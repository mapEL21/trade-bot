# Trade Bot settings on the server. Edit, then apply: sudo systemctl restart trade-bot
# This file is created once and never overwritten by updates.
ASPNETCORE_ENVIRONMENT=Production
Api__Port=5080

# Data: database, market recordings, scanner recordings.
Storage__Path=/var/lib/trade-bot/workspace.db
Market__Path=/var/lib/trade-bot/market
Scanner__Path=/var/lib/trade-bot/scans
Ui__Path=/opt/trade-bot/wwwroot

# Disk upkeep: compress finished recordings, delete recordings older than N days (0 keeps all),
# copy the database once a day into /var/lib/trade-bot/backups (last 7 kept).
Storage__Housekeeping=true
# The signal lab processes new finished recordings on its own every few minutes.
Lab__AutoProcess=true
# The density screener goes round every Binance USDT perpetual order book from the server start.
Screener__AutoStart=true
Storage__RetentionDays=14
Storage__BackupHours=24
Storage__Backups=7

# Level scanner runs continuously from the server start: a new recording every hour.
Scanner__AutoStart=true
Scanner__MinQuoteVolume=150000000
Scanner__MaxSymbols=20
Scanner__Exclude=
# Coins with a smaller 24-hour range, %, are not recorded (BTC, ETH on calm days): fees eat the risk on them.
Scanner__MinRangePct=4

# Private address of the server in Tailscale, for example trade-bot.tail1234.ts.net (without https://).
# Empty: the interface is reachable only through an SSH tunnel.
Remote__Host=
